# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Whitelisted Telegram User ID (single ID or comma-separated integers)
# Messages from users not in this list will be rejected for security.
ALLOWED_USER_IDS=123456789

# Path to Antigravity CLI binary (default: agy or ~/.local/bin/agy)
AGY_BIN_PATH=agy

# Working directory where agy commands will execute (e.g. /home/username/workspace or ./)
AGY_WORKING_DIR=./

# Timeout for individual agy prompt execution (in minutes, default: 5)
AGY_TIMEOUT_MINUTES=5

# Default agent execution mode (auto, plan, accept-edits)
AGY_DEFAULT_MODE=auto

# Optional default model override (leave empty to use CLI default)
AGY_DEFAULT_MODEL=

# Enable verbose thinking stream by default (true/false, default: false)
AGY_VERBOSE_THINKING=false

# Optional outbound proxy specifically for Telegram Bot API (e.g., socks5://127.0.0.1:9050 or http://proxy:port)
TELEGRAM_PROXY=
